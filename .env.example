# Brevo: obrigatórias para cadastrar contatos, somente no servidor.
# Obtenha a chave na sua conta Brevo; nunca use prefixo NEXT_PUBLIC_.
BREVO_API_KEY=
# ID inteiro positivo da lista de contatos que receberá as inscrições.
BREVO_LIST_ID=

# URL pública completa, sem caminho, usada no build para SEO e compartilhamento.
# Preencha com a URL real. Na Vercel, as URLs automáticas são usadas se vazio.
# Em desenvolvimento local, o fallback é http://localhost:3000.
SITE_URL=
